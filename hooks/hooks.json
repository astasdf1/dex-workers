{
  "description": "Apply the managed delegation-first user policy once, without delaying startup",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/setup.py", "session-start"],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
